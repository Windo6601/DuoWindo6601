rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. User Profile rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow delete: if isOwner(userId);

      allow create: if isOwner(userId) 
        && isValidId(userId) 
        && isValidUserProfile(incoming()) 
        && incoming().createdAt == request.time 
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId) 
        && isValidUserProfile(incoming()) 
        && incoming().createdAt == existing().createdAt 
        && incoming().updatedAt == request.time;
    }

    // 3. Feedback / Reviews rules
    match /feedback/{feedbackId} {
      allow read: if true;
      allow list: if true;

      allow create: if isSignedIn()
        && isValidId(feedbackId)
        && incoming().userId == request.auth.uid
        && isValidFeedback(incoming())
        && incoming().createdAt == request.time;

      allow update: if isSignedIn()
        && isValidFeedback(incoming())
        && (
          incoming().userId == request.auth.uid ||
          incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likedBy', 'replies', 'isPinned'])
        );

      allow delete: if isSignedIn();
    }

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.name is string && data.name.size() <= 100
        && (!('username' in data) || (data.username is string && data.username.size() <= 100))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2000))
        && (!('avatarImage' in data) || (data.avatarImage is string && data.avatarImage.size() <= 1000000))
        && (!('avatarIcon' in data) || (data.avatarIcon is string && data.avatarIcon.size() <= 50))
        && data.avatarColor is string && data.avatarColor.size() <= 50
        && data.energy is int && data.energy >= 0 && data.energy <= 10000
        && data.hearts is int && data.hearts >= 0 && data.hearts <= 1000
        && data.subscription is string && (data.subscription == 'free' || data.subscription == 'super' || data.subscription == 'max')
        && data.streak is int && data.streak >= 0
        && data.gems is int && data.gems >= 0
        && data.xp is int && data.xp >= 0
        && data.currentUnit is int && data.currentUnit >= 1
        && data.completedLessons is list
        && data.mistakes is list
        && data.learnedWords is list
        && data.achievements is list
        && data.language is string && data.language.size() <= 5
        && data.country is string && data.country.size() <= 100;
    }

    function isValidFeedback(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 100
        && (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 2000))
        && (!('userColor' in data) || (data.userColor is string && data.userColor.size() <= 50))
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000
        && (!('likes' in data) || (data.likes is int && data.likes >= 0))
        && (!('likedBy' in data) || (data.likedBy is list && data.likedBy.size() <= 5000))
        && (!('replies' in data) || (data.replies is list && data.replies.size() <= 500))
        && (!('isPinned' in data) || (data.isPinned is bool));
    }
  }
}
