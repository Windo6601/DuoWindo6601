{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User progress and settings stored securely",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The user's display name" },
        "username": { "type": "string", "description": "The user's unique handle" },
        "phone": { "type": "string", "description": "User phone number" },
        "hidePhone": { "type": "boolean", "description": "Hide phone number flag" },
        "email": { "type": "string", "description": "User email address" },
        "hideEmail": { "type": "boolean", "description": "Hide email address flag" },
        "link": { "type": "string", "description": "User profile link or website" },
        "hideLink": { "type": "boolean", "description": "Hide profile link flag" },
        "authProvider": { "type": "string", "description": "Authentication provider" },
        "avatarColor": { "type": "string", "description": "The background color of the avatar" },
        "avatarImage": { "type": "string", "description": "Base64 avatar image string" },
        "avatarUrl": { "type": "string", "description": "Avatar image URL" },
        "avatarIcon": { "type": "string", "description": "Avatar emoji or icon" },
        "energy": { "type": "integer", "description": "Current energy level" },
        "hearts": { "type": "integer", "description": "Current hearts count" },
        "subscription": { "type": "string", "enum": ["free", "super", "max"], "description": "Active subscription plan" },
        "streak": { "type": "integer", "description": "Current active streak in days" },
        "gems": { "type": "integer", "description": "Current balance of gems" },
        "xp": { "type": "integer", "description": "Total user XP" },
        "currentUnit": { "type": "integer", "description": "Current lesson unit" },
        "completedLessons": { "type": "array", "description": "List of completed lesson IDs" },
        "mistakes": { "type": "array", "description": "List of active mistakes to review" },
        "learnedWords": { "type": "array", "description": "List of words successfully learned" },
        "achievements": { "type": "array", "description": "List of unlocked achievements" },
        "language": { "type": "string", "enum": ["ru", "en", "de", "fr", "es", "ja", "zh", "ar"], "description": "Interface language" },
        "country": { "type": "string", "description": "User's country" },
        "preferredVoice": { "type": "string", "description": "Voice used for TTS" },
        "voiceProvider": { "type": "string", "enum": ["gemini", "google", "yandex", "system"], "description": "Selected TTS provider" },
        "chessStats": { "type": "object", "description": "Chess puzzle statistics" },
        "dailyAiRequestsCount": { "type": "integer", "description": "Number of Gemini API requests used today" },
        "bonusAiRequests": { "type": "integer", "description": "Bonus Gemini API requests purchased or gifted" },
        "lastAiRequestDate": { "type": "string", "description": "Date YYYY-MM-DD of last Gemini API request" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Profile creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Profile last update timestamp" }
      },
      "required": ["name"]
    },
    "Feedback": {
      "title": "User Feedback",
      "description": "User reviews and feedback for DuoWindo6601",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID of the user who submitted feedback" },
        "userName": { "type": "string", "description": "Display name of the author" },
        "userAvatar": { "type": "string", "description": "Avatar emoji, icon or URL" },
        "userColor": { "type": "string", "description": "Color associated with user" },
        "rating": { "type": "integer", "description": "Rating out of 5 stars (1 to 5)" },
        "category": { "type": "string", "description": "Category of feedback e.g. general, feature, bug, praise" },
        "comment": { "type": "string", "description": "Review text content" },
        "likes": { "type": "integer", "description": "Number of upvotes/likes" },
        "likedBy": { "type": "array", "description": "List of user IDs who liked this review" },
        "replies": { "type": "array", "description": "Comments and administrator replies" },
        "isPinned": { "type": "boolean", "description": "Whether review is pinned by administrator" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["userId", "userName", "rating", "comment", "createdAt"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "description": "User support ticket sent to technical support",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User handle or ID" },
        "userName": { "type": "string", "description": "Name of user submitting ticket" },
        "email": { "type": "string", "description": "Contact email" },
        "subject": { "type": "string", "description": "Subject of the inquiry" },
        "message": { "type": "string", "description": "Detailed question or issue" },
        "targetEmails": { "type": "array", "description": "Support staff recipient emails" },
        "status": { "type": "string", "description": "Status of the ticket" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["userId", "userName", "message", "status"]
    },
    "SystemConfig": {
      "title": "System Configuration",
      "description": "Global settings, Gemini API keys and server flags managed by administrators",
      "type": "object",
      "properties": {
        "adminApiKey": { "type": "string", "description": "Admin Gemini API key" },
        "adminKeyType": { "type": "string", "enum": ["free", "paid"], "description": "Admin key tier" },
        "adminKeyEnabled": { "type": "boolean", "description": "Whether admin key is enabled" },
        "devApiKey": { "type": "string", "description": "Developer Gemini API key" },
        "devKeyType": { "type": "string", "enum": ["free", "paid"], "description": "Developer key tier" },
        "devKeyEnabled": { "type": "boolean", "description": "Whether developer key is enabled" },
        "keyPriority": { "type": "string", "description": "Active key priority strategy" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" },
        "updatedBy": { "type": "string", "description": "Email or ID of updating administrator" }
      }
    },
    "ChessRoom": {
      "title": "Chess Room",
      "description": "Multiplayer chess room state synchronized across users",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "description": "Unique room ID" },
        "hostId": { "type": "string", "description": "ID of host player (White)" },
        "hostName": { "type": "string", "description": "Name of host player" },
        "hostAvatar": { "type": "string", "description": "Avatar of host player" },
        "hostElo": { "type": "integer", "description": "ELO rating of host player" },
        "guestId": { "type": "string", "description": "ID of guest player (Black)" },
        "guestName": { "type": "string", "description": "Name of guest player" },
        "guestAvatar": { "type": "string", "description": "Avatar of guest player" },
        "guestElo": { "type": "integer", "description": "ELO rating of guest player" },
        "fen": { "type": "string", "description": "Current chess board FEN notation" },
        "turn": { "type": "string", "enum": ["w", "b"], "description": "Active player turn" },
        "status": { "type": "string", "enum": ["waiting", "active", "finished", "abandoned"], "description": "Game status" },
        "winner": { "type": "string", "description": "Winner player ID or draw status" },
        "lastMove": { "type": "object", "description": "Last move coordinates" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Room creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last move or update timestamp" }
      },
      "required": ["hostId", "fen", "turn", "status"]
    },
    "SharedSession": {
      "title": "Shared Session",
      "description": "Collaborative session room for multi-user shared access",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "description": "Unique session ID" },
        "creatorId": { "type": "string", "description": "Creator user ID" },
        "creatorName": { "type": "string", "description": "Creator user display name" },
        "title": { "type": "string", "description": "Session title or subject" },
        "participants": { "type": "array", "description": "List of active connected participant IDs" },
        "activeCount": { "type": "integer", "description": "Number of active participants" },
        "sharedState": { "type": "object", "description": "Synchronized session state" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Session creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last activity timestamp" }
      },
      "required": ["creatorId", "sessionId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "The user profile document containing progress, settings, and stats"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Public user feedback and app reviews for DuoWindo6601"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support tickets submitted by users"
    },
    "/system_config/{configId}": {
      "schema": "SystemConfig",
      "description": "Global system configurations and API keys restricted to administrators"
    },
    "/chess_rooms/{roomId}": {
      "schema": "ChessRoom",
      "description": "Real-time multiplayer chess games"
    },
    "/shared_sessions/{sessionId}": {
      "schema": "SharedSession",
      "description": "Real-time collaborative applet sessions"
    }
  }
}
