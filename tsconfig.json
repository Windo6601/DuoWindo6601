{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "types": ["node", "vite/client", "vite-plugin-pwa/client"]
  },
  "include": [
    "App.tsx",
    "index.tsx",
    "types.ts",
    "firebase.ts",
    "components/**/*",
    "services/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "android",
    "capacitor.config.ts",
    "server.ts"
  ]
}
