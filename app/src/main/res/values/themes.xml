<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for the single Compose activity. Light theme is the default. -->
    <style name="Theme.DuoWindo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/duo_green</item>
        <item name="android:statusBarColor">@color/duo_green</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
